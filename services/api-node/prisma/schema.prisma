generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CAPTURE_AGENT
  DESIGNER
  REVIEWER
  ADMIN
}

enum CaptureMode {
  PROPERTY_TOUR
  DESIGN_SCAN
}

enum CapturePlatform {
  ANDROID
  IOS
  WEB
}

enum CaptureStatus {
  DRAFT
  CAPTURING
  UPLOADING
  PROCESSING
  READY
  RECAPTURE_REQUIRED
  PUBLISHED
  ARCHIVED
}

enum AssetKind {
  PANORAMA
  PHOTO
  VIDEO
  THUMBNAIL
  AR_POSES
  CAMERA_INTRINSICS
  DEPTH_MAP
  DEPTH_CONFIDENCE
  ROOMPLAN_USDZ
  FLOORPLAN
  GLB
  DESIGN_PREVIEW
  RGB_KEYFRAME
  AR_PLANES
  CAPTURE_MANIFEST
  MODEL_EVIDENCE
  FLOORPLAN_SVG
  DESIGN_RENDER
  DESIGN_EXPORT
  OTHER
}

enum AssetStatus {
  PENDING
  UPLOADED
  PROCESSING
  APPROVED
  REJECTED
}

enum JobType {
  PANORAMA_STITCH
  PANORAMA_QA
  PRIVACY_SCAN
  CAPTURE_VALIDATION
  CAPTURE_PACKAGE_VALIDATE
  KEYFRAME_PROCESS
  DEPTH_FUSE
  SURFACE_EXTRACT
  ROOM_MODEL_INFER
  OPENING_INFER
  MODEL_OPTIMIZE
  MODEL_QA
  MODEB_GEOMETRY
  SCENE_ASSEMBLE
  ASSET_OPTIMIZE
  RENDER_PREVIEW
  RENDER_FINAL
  EXPORT_PARAMETRIC_SHELL_GLB
  EXPORT_MODEL
  EXPORT_PLAN
  EXPORT_SCHEDULE
  ROOM_SHELL
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum TourStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum VerificationLabel {
  ACTUAL_UNIT
  SAMPLE_FLAT
  CGI_RENDER
  PHOTO_STORY
  VIDEO_TOUR
  PANORAMA_TOUR
  RECONSTRUCTED_3D
  DESIGN_CONCEPT
}

enum DesignStatus {
  DRAFT
  MODEL_GENERATING
  DRAFT_MODEL_READY
  DESIGNER_CORRECTION
  DESIGNER_CONFIRMED
  CLIENT_PRESENTATION_READY
  READY
  PUBLISHED
  ARCHIVED
}

model Organization {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users      User[]
  properties Property[]
}

model User {
  id            String         @id @default(cuid())
  phone         String         @unique
  name          String?
  role          UserRole       @default(OWNER)
  organizationId String
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  captures      CaptureSession[]
  designVersions DesignVersion[]

  @@index([organizationId])
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, expiresAt])
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  propertyType   String
  latitude       Float?
  longitude      Float?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  units          Unit[]

  @@index([organizationId])
}

model Unit {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label       String
  bedrooms    Int?
  bathrooms   Int?
  areaSqFt    Float?
  price       Float?
  availability String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  captures    CaptureSession[]
  tours       Tour[]
  designProjects DesignProject[]

  @@index([propertyId])
}

model CaptureSession {
  id             String          @id @default(cuid())
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  mode           CaptureMode
  platform       CapturePlatform
  status         CaptureStatus   @default(DRAFT)
  deviceMetadata Json?
  checklist      Json?
  qualityReport  Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rooms          Room[]
  assets         Asset[]
  connections    CaptureConnection[]
  jobs           ProcessingJob[]
  tours          Tour[]
  designProjects DesignProject[]
  capturePackages CapturePackage[]

  @@index([unitId])
  @@index([createdById])
}

model Room {
  id               String         @id @default(cuid())
  captureId        String
  capture          CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  name             String
  sortOrder        Int            @default(0)
  panoramaAssetId  String?
  ceilingHeightM   Float?
  floorPolygon     Json?
  measurements     Json?
  roomModel        Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  assets           Asset[]
  outgoingConnections CaptureConnection[] @relation("ConnectionFrom")
  incomingConnections CaptureConnection[] @relation("ConnectionTo")
  outgoingHotspots Hotspot[] @relation("HotspotFrom")
  incomingHotspots Hotspot[] @relation("HotspotTo")
  // Mode B stores each measurement as its own row so it can carry provenance
  // (method, tolerance, who confirmed it, evidence refs). The legacy
  // `measurements Json?` field above is a different thing: the Mode A inline
  // {lengthM, widthM} blob written by the capture routes. Both are still in
  // use, so the relation is named distinctly rather than either being dropped.
  measurementRecords Measurement[]
  geometryProposals GeometryProposal[]

  @@index([captureId])
}

model CaptureConnection {
  id         String         @id @default(cuid())
  captureId  String
  capture    CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  fromRoomId String
  fromRoom   Room           @relation("ConnectionFrom", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoomId   String
  toRoom     Room           @relation("ConnectionTo", fields: [toRoomId], references: [id], onDelete: Cascade)
  label      String?
  createdAt  DateTime       @default(now())

  @@unique([captureId, fromRoomId, toRoomId])
  @@index([captureId])
}

model Asset {
  id         String         @id @default(cuid())
  captureId  String
  capture    CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  roomId     String?
  room       Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  kind       AssetKind
  objectKey  String         @unique
  mimeType   String
  sizeBytes  BigInt
  checksumSha256 String?
  status     AssetStatus    @default(PENDING)
  metadata   Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  jobs       ProcessingJob[]

  @@index([captureId])
  @@index([roomId])
}

model ProcessingJob {
  id          String         @id @default(cuid())
  type        JobType
  status      JobStatus      @default(QUEUED)
  progress    Int            @default(0)
  captureId   String?
  capture     CaptureSession? @relation(fields: [captureId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  designProjectId String?
  designProject DesignProject? @relation(fields: [designProjectId], references: [id], onDelete: SetNull)
  input       Json?
  output      Json?
  error       String?
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([captureId])
  @@index([status])
}

model Tour {
  id                String            @id @default(cuid())
  unitId            String
  unit              Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  captureId         String
  capture           CaptureSession    @relation(fields: [captureId], references: [id], onDelete: Cascade)
  title             String
  slug              String            @unique
  status            TourStatus        @default(DRAFT)
  verificationLabel VerificationLabel @default(PANORAMA_TOUR)
  captureDate       DateTime
  manifest          Json?
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  hotspots          Hotspot[]
  leads             Lead[]

  @@index([unitId])
  @@index([captureId])
}

model Hotspot {
  id         String   @id @default(cuid())
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  fromRoomId String
  fromRoom   Room     @relation("HotspotFrom", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoomId   String
  toRoom     Room     @relation("HotspotTo", fields: [toRoomId], references: [id], onDelete: Cascade)
  yaw        Float
  pitch      Float
  label      String
  createdAt  DateTime @default(now())

  @@index([tourId])
}

model Lead {
  id        String   @id @default(cuid())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  name      String?
  phone     String?
  email     String?
  action    String
  consent   Boolean
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tourId])
}

model DesignProject {
  id              String       @id @default(cuid())
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  captureId       String
  capture         CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  name            String
  status          DesignStatus @default(DRAFT)
  slug            String       @unique
  activeVersion   Int          @default(1)
  model           Json
  generatedGlbKey String?
  geometryStatus  String       @default("DRAFT_MODEL")
  verificationStatus String    @default("UNCONFIRMED")
  geometryReport Json?
  publicManifest  Json?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  versions        DesignVersion[]
  jobs            ProcessingJob[]
  comments        DesignComment[]
  approvals       DesignApproval[]
  options         DesignOption[]
  reviews         ModelReview[]
  exports         ExportRecord[]
  shareLinks      ClientShareLink[]

  @@index([unitId])
  @@index([captureId])
}

model DesignVersion {
  id            String        @id @default(cuid())
  projectId     String
  project       DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int
  model         Json
  notes         String?
  label         String?
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@unique([projectId, version])
}

model DesignComment {
  id         String        @id @default(cuid())
  projectId  String
  project    DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  body       String
  elementId  String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([projectId, createdAt])
}

model DesignApproval {
  id         String        @id @default(cuid())
  projectId  String
  project    DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int
  decision   String
  name       String?
  contact    String?
  note       String?
  createdAt  DateTime      @default(now())

  @@index([projectId, createdAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  entityType     String
  entityId       String
  action         String
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}


model CapturePackage {
  id               String         @id @default(cuid())
  captureId        String
  capture          CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  roomId           String?
  schemaVersion    String
  captureType      String
  manifestAssetId  String?
  archiveAssetId   String?
  checksumVerified Boolean        @default(false)
  keyframeCount    Int            @default(0)
  status           String         @default("UPLOADED")
  quality          Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([captureId, roomId])
}

model Measurement {
  id                 String   @id @default(cuid())
  roomId             String
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label              String
  valueM             Float
  startPoint          Json?
  endPoint            Json?
  method              String
  toleranceM          Float?
  verificationStatus  String   @default("UNVERIFIED")
  evidenceRefs        Json?
  acquiredById        String?
  acquiredAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([roomId])
}

model GeometryProposal {
  id               String   @id @default(cuid())
  roomId           String
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  proposalType     String
  geometry         Json
  confidence       Float
  uncertaintyM     Float?
  evidenceRefs     Json?
  processorVersion String
  status           String   @default("PROPOSED")
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([roomId, status])
}

model ModelReview {
  id               String        @id @default(cuid())
  projectId        String
  project          DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version          Int
  reviewerId       String?
  decision         String
  notes            String?
  verificationStatus String
  createdAt        DateTime      @default(now())

  @@index([projectId, createdAt])
}

model DesignOption {
  id             String        @id @default(cuid())
  projectId      String
  project        DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         String        @default("DRAFT")
  activeVersion  Int           @default(1)
  model          Json
  previewAssetId String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projectId])
}

model ExportRecord {
  id             String        @id @default(cuid())
  projectId      String
  project        DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designOptionId String?
  version        Int
  format         String
  status         String        @default("QUEUED")
  privateObjectKey String?
  publicObjectKey  String?
  mimeType       String?
  sizeBytes      BigInt?
  metadata       Json?
  error          String?
  createdById    String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([projectId, createdAt])
}

model ClientShareLink {
  id             String        @id @default(cuid())
  projectId      String
  project        DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug           String        @unique
  designOptionId String?
  version        Int
  mode           String        @default("PUBLIC")
  expiresAt      DateTime?
  revokedAt      DateTime?
  permissions    Json?
  createdById    String?
  createdAt      DateTime      @default(now())

  @@index([projectId])
}

model CatalogueAsset {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  category       String
  glbObjectKey   String
  thumbnailKey   String?
  dimensionsM    Json
  anchor         Json?
  placementRules Json?
  polygonCount   Int?
  textureBytes   BigInt?
  metadata       Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, category])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String?
  sku            String
  name           String
  category       String
  supplier       String?
  catalogueAssetId String?
  metadata       Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  variants       ProductVariant[]

  @@unique([organizationId, sku])
  @@index([category])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  materialId  String?
  price       Float?
  currency    String?
  priceVersion String?
  availability String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

model Material {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  category       String
  supplier       String?
  sku            String?
  textureSet     Json?
  physical       Json?
  realWorldSizeM Json?
  costPerUnit    Float?
  unit           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, category])
}
