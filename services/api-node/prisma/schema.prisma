generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CAPTURE_AGENT
  DESIGNER
  REVIEWER
  ADMIN
}

enum CaptureMode {
  PROPERTY_TOUR
  DESIGN_SCAN
}

enum CapturePlatform {
  ANDROID
  IOS
  WEB
}

enum CaptureStatus {
  DRAFT
  CAPTURING
  UPLOADING
  PROCESSING
  READY
  RECAPTURE_REQUIRED
  PUBLISHED
  ARCHIVED
}

enum AssetKind {
  PANORAMA
  PHOTO
  VIDEO
  THUMBNAIL
  AR_POSES
  CAMERA_INTRINSICS
  DEPTH_MAP
  DEPTH_CONFIDENCE
  ROOMPLAN_USDZ
  FLOORPLAN
  GLB
  DESIGN_PREVIEW
  RGB_KEYFRAME
  AR_PLANES
  CAPTURE_MANIFEST
  MODEL_EVIDENCE
  FLOORPLAN_SVG
  DESIGN_RENDER
  DESIGN_EXPORT
  OTHER
}

enum AssetStatus {
  PENDING
  UPLOADED
  PROCESSING
  APPROVED
  REJECTED
}

enum JobType {
  PANORAMA_STITCH
  PANORAMA_QA
  PRIVACY_SCAN
  CAPTURE_VALIDATION
  CAPTURE_PACKAGE_VALIDATE
  KEYFRAME_PROCESS
  DEPTH_FUSE
  SURFACE_EXTRACT
  ROOM_MODEL_INFER
  OPENING_INFER
  MODEL_OPTIMIZE
  MODEL_QA
  MODEB_GEOMETRY
  SCENE_ASSEMBLE
  ASSET_OPTIMIZE
  RENDER_PREVIEW
  RENDER_FINAL
  EXPORT_PARAMETRIC_SHELL_GLB
  EXPORT_MODEL
  EXPORT_PLAN
  EXPORT_SCHEDULE
  ROOM_SHELL
  PROGRESS_INTELLIGENCE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum TourStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum VerificationLabel {
  ACTUAL_UNIT
  SAMPLE_FLAT
  CGI_RENDER
  PHOTO_STORY
  VIDEO_TOUR
  PANORAMA_TOUR
  RECONSTRUCTED_3D
  DESIGN_CONCEPT
}

enum DesignStatus {
  DRAFT
  MODEL_GENERATING
  DRAFT_MODEL_READY
  DESIGNER_CORRECTION
  DESIGNER_CONFIRMED
  CLIENT_PRESENTATION_READY
  READY
  PUBLISHED
  ARCHIVED
}

model Organization {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users      User[]
  properties Property[]
}

model User {
  id            String         @id @default(cuid())
  phone         String         @unique
  name          String?
  role          UserRole       @default(OWNER)
  organizationId String
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  captures      CaptureSession[]
  designVersions DesignVersion[]

  @@index([organizationId])
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, expiresAt])
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  propertyType   String
  latitude       Float?
  longitude      Float?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  units          Unit[]

  @@index([organizationId])
}

model Unit {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label       String
  bedrooms    Int?
  bathrooms   Int?
  areaSqFt    Float?
  price       Float?
  availability String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  captures    CaptureSession[]
  tours       Tour[]
  designProjects DesignProject[]
  progressProjects ProgressProject[]

  @@index([propertyId])
}

model CaptureSession {
  id             String          @id @default(cuid())
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  mode           CaptureMode
  platform       CapturePlatform
  status         CaptureStatus   @default(DRAFT)
  deviceMetadata Json?
  checklist      Json?
  qualityReport  Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rooms          Room[]
  assets         Asset[]
  connections    CaptureConnection[]
  jobs           ProcessingJob[]
  tours          Tour[]
  designProjects DesignProject[]
  capturePackages CapturePackage[]
  snapshot       CaptureSnapshot?
  resumableUploads ResumableUpload[]

  @@index([unitId])
  @@index([createdById])
}

model Room {
  id               String         @id @default(cuid())
  captureId        String
  capture          CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  name             String
  sortOrder        Int            @default(0)
  panoramaAssetId  String?
  spatialRoomId    String?
  spatialRoom      SpatialRoom? @relation(fields: [spatialRoomId], references: [id], onDelete: SetNull)
  ceilingHeightM   Float?
  floorPolygon     Json?
  measurements     Json?
  roomModel        Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  assets           Asset[]
  outgoingConnections CaptureConnection[] @relation("ConnectionFrom")
  incomingConnections CaptureConnection[] @relation("ConnectionTo")
  outgoingHotspots Hotspot[] @relation("HotspotFrom")
  incomingHotspots Hotspot[] @relation("HotspotTo")
  // Mode B stores each measurement as its own row so it can carry provenance
  // (method, tolerance, who confirmed it, evidence refs). The legacy
  // `measurements Json?` field above is a different thing: the Mode A inline
  // {lengthM, widthM} blob written by the capture routes. Both are still in
  // use, so the relation is named distinctly rather than either being dropped.
  measurementRecords Measurement[]
  geometryProposals GeometryProposal[]
  resumableUploads ResumableUpload[]

  @@index([captureId])
  @@index([spatialRoomId])
}

model CaptureConnection {
  id         String         @id @default(cuid())
  captureId  String
  capture    CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  fromRoomId String
  fromRoom   Room           @relation("ConnectionFrom", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoomId   String
  toRoom     Room           @relation("ConnectionTo", fields: [toRoomId], references: [id], onDelete: Cascade)
  label      String?
  createdAt  DateTime       @default(now())

  @@unique([captureId, fromRoomId, toRoomId])
  @@index([captureId])
}

model Asset {
  id         String         @id @default(cuid())
  captureId  String
  capture    CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  roomId     String?
  room       Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  spatialRoomId String?
  spatialRoom SpatialRoom?  @relation(fields: [spatialRoomId], references: [id], onDelete: SetNull)
  kind       AssetKind
  objectKey  String         @unique
  mimeType   String
  sizeBytes  BigInt
  checksumSha256 String?
  status     AssetStatus    @default(PENDING)
  metadata   Json?
  coordinateFrame Json?
  spatialTransform Json?
  spatialVersion Int @default(1)
  quality    Json?
  provenance Json?
  visibility String @default("PRIVATE")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  jobs       ProcessingJob[]
  resumableUpload ResumableUpload?

  @@index([captureId])
  @@index([roomId])
  @@index([spatialRoomId])
}

model ResumableUpload {
  id                 String         @id @default(cuid())
  captureId          String
  capture            CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  roomId             String?
  room               Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assetId            String         @unique
  asset              Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  idempotencyKey     String
  requestFingerprint String
  filename           String
  mimeType           String
  kind               AssetKind
  totalSizeBytes     BigInt
  chunkSizeBytes     Int
  totalParts         Int
  checksumSha256     String?
  status             String         @default("CREATED")
  uploadedBytes      BigInt         @default(0)
  lastError          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?
  parts              ResumableUploadPart[]

  @@unique([captureId, idempotencyKey])
  @@index([captureId, status])
}

model ResumableUploadPart {
  id             String          @id @default(cuid())
  uploadId       String
  upload         ResumableUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  partNumber     Int
  objectKey      String          @unique
  sizeBytes      BigInt
  checksumSha256 String?
  status         String          @default("PENDING")
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  @@unique([uploadId, partNumber])
  @@index([uploadId, status])
}

model ProcessingJob {
  id          String         @id @default(cuid())
  type        JobType
  status      JobStatus      @default(QUEUED)
  progress    Int            @default(0)
  captureId   String?
  capture     CaptureSession? @relation(fields: [captureId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  designProjectId String?
  designProject DesignProject? @relation(fields: [designProjectId], references: [id], onDelete: SetNull)
  input       Json?
  output      Json?
  error       String?
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  analysisRun ProgressAnalysisRun?

  @@index([captureId])
  @@index([status])
}

model Tour {
  id                String            @id @default(cuid())
  unitId            String
  unit              Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  captureId         String
  capture           CaptureSession    @relation(fields: [captureId], references: [id], onDelete: Cascade)
  title             String
  slug              String            @unique
  status            TourStatus        @default(DRAFT)
  verificationLabel VerificationLabel @default(PANORAMA_TOUR)
  captureDate       DateTime
  manifest          Json?
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  hotspots          Hotspot[]
  leads             Lead[]

  @@index([unitId])
  @@index([captureId])
}

model Hotspot {
  id         String   @id @default(cuid())
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  fromRoomId String
  fromRoom   Room     @relation("HotspotFrom", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoomId   String
  toRoom     Room     @relation("HotspotTo", fields: [toRoomId], references: [id], onDelete: Cascade)
  yaw        Float
  pitch      Float
  label      String
  createdAt  DateTime @default(now())

  @@index([tourId])
}

model Lead {
  id        String   @id @default(cuid())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  name      String?
  phone     String?
  email     String?
  action    String
  consent   Boolean
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tourId])
}

model DesignProject {
  id              String       @id @default(cuid())
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  captureId       String
  capture         CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  name            String
  status          DesignStatus @default(DRAFT)
  slug            String       @unique
  activeVersion   Int          @default(1)
  model           Json
  generatedGlbKey String?
  geometryStatus  String       @default("DRAFT_MODEL")
  verificationStatus String    @default("UNCONFIRMED")
  geometryReport Json?
  publicManifest  Json?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  versions        DesignVersion[]
  jobs            ProcessingJob[]
  comments        DesignComment[]
  approvals       DesignApproval[]
  options         DesignOption[]
  reviews         ModelReview[]
  exports         ExportRecord[]
  shareLinks      ClientShareLink[]
  progressSnapshots CaptureSnapshot[] @relation("SnapshotDesignReference")
  designRealityAlignments DesignRealityAlignment[]

  @@index([unitId])
  @@index([captureId])
}

model DesignVersion {
  id            String        @id @default(cuid())
  projectId     String
  project       DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int
  model         Json
  notes         String?
  label         String?
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@unique([projectId, version])
}

model DesignComment {
  id         String        @id @default(cuid())
  projectId  String
  project    DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?
  body       String
  elementId  String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([projectId, createdAt])
}

model DesignApproval {
  id         String        @id @default(cuid())
  projectId  String
  project    DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int
  decision   String
  name       String?
  contact    String?
  note       String?
  createdAt  DateTime      @default(now())

  @@index([projectId, createdAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  entityType     String
  entityId       String
  action         String
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}


model CapturePackage {
  id               String         @id @default(cuid())
  captureId        String
  capture          CaptureSession @relation(fields: [captureId], references: [id], onDelete: Cascade)
  roomId           String?
  schemaVersion    String
  captureType      String
  manifestAssetId  String?
  archiveAssetId   String?
  checksumVerified Boolean        @default(false)
  keyframeCount    Int            @default(0)
  status           String         @default("UPLOADED")
  quality          Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([captureId, roomId])
}

model Measurement {
  id                 String   @id @default(cuid())
  roomId             String
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label              String
  valueM             Float
  startPoint          Json?
  endPoint            Json?
  method              String
  toleranceM          Float?
  verificationStatus  String   @default("UNVERIFIED")
  evidenceRefs        Json?
  acquiredById        String?
  acquiredAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([roomId])
}

model GeometryProposal {
  id               String   @id @default(cuid())
  roomId           String
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  proposalType     String
  geometry         Json
  confidence       Float
  uncertaintyM     Float?
  evidenceRefs     Json?
  processorVersion String
  status           String   @default("PROPOSED")
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([roomId, status])
}

model ModelReview {
  id               String        @id @default(cuid())
  projectId        String
  project          DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version          Int
  reviewerId       String?
  decision         String
  notes            String?
  verificationStatus String
  createdAt        DateTime      @default(now())

  @@index([projectId, createdAt])
}

model DesignOption {
  id             String        @id @default(cuid())
  projectId      String
  project        DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         String        @default("DRAFT")
  activeVersion  Int           @default(1)
  model          Json
  previewAssetId String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projectId])
}

model ExportRecord {
  id             String        @id @default(cuid())
  projectId      String
  project        DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designOptionId String?
  version        Int
  format         String
  status         String        @default("QUEUED")
  privateObjectKey String?
  publicObjectKey  String?
  mimeType       String?
  sizeBytes      BigInt?
  metadata       Json?
  error          String?
  createdById    String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([projectId, createdAt])
}

model ClientShareLink {
  id             String        @id @default(cuid())
  projectId      String
  project        DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug           String        @unique
  designOptionId String?
  version        Int
  mode           String        @default("PUBLIC")
  expiresAt      DateTime?
  revokedAt      DateTime?
  permissions    Json?
  createdById    String?
  createdAt      DateTime      @default(now())

  @@index([projectId])
}

model CatalogueAsset {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  category       String
  glbObjectKey   String
  thumbnailKey   String?
  dimensionsM    Json
  anchor         Json?
  placementRules Json?
  polygonCount   Int?
  textureBytes   BigInt?
  metadata       Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, category])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String?
  sku            String
  name           String
  category       String
  supplier       String?
  catalogueAssetId String?
  metadata       Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  variants       ProductVariant[]

  @@unique([organizationId, sku])
  @@index([category])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  materialId  String?
  price       Float?
  currency    String?
  priceVersion String?
  availability String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

model Material {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  category       String
  supplier       String?
  sku            String?
  textureSet     Json?
  physical       Json?
  realWorldSizeM Json?
  costPerUnit    Float?
  unit           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, category])
}

// -----------------------------------------------------------------------------
// ProgressionAi spatial-temporal foundation (v1)
// -----------------------------------------------------------------------------
// These entities are additive. Existing PropertyTour360 Mode A / Mode B records
// continue to work unchanged while new captures can be attached to a stable
// project/floor/room identity that survives across capture sessions.

model ProgressProject {
  id              String   @id @default(cuid())
  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name            String
  status          String   @default("ACTIVE")
  captureCadence  String?
  projectFrame    Json?
  progressPolicy  Json?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  floors          SpatialFloor[]
  rooms           SpatialRoom[]
  snapshots       CaptureSnapshot[]
  registrations   CaptureRegistration[]
  issues          ProjectIssue[]
  observations    AiObservation[]
  reports         ProjectReport[]
  designRealityAlignments DesignRealityAlignment[]
  designRealityEvaluations DesignRealityEvaluation[]
  analysisRuns    ProgressAnalysisRun[]

  @@index([unitId])
  @@index([createdById])
}

model SpatialFloor {
  id          String          @id @default(cuid())
  projectId   String
  project     ProgressProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  level       Int?
  elevationM  Float?
  transform   Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  rooms       SpatialRoom[]
  snapshots   CaptureSnapshot[]

  @@index([projectId])
}

model SpatialRoom {
  id                String          @id @default(cuid())
  projectId         String
  project           ProgressProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorId           String?
  floor             SpatialFloor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  name              String
  roomType          String?
  sortOrder         Int             @default(0)
  canonicalFrame    Json?
  canonicalGeometry Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  captureRooms      Room[]
  assets            Asset[]
  issues            ProjectIssue[]
  observations      AiObservation[]
  designRealityAlignments DesignRealityAlignment[]
  analysisRuns      ProgressAnalysisRun[]

  @@index([projectId])
  @@index([floorId])
  @@index([projectId, name])
}

model CaptureSnapshot {
  id                    String          @id @default(cuid())
  projectId             String
  project               ProgressProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  captureId             String          @unique
  capture               CaptureSession  @relation(fields: [captureId], references: [id], onDelete: Cascade)
  floorId               String?
  floor                 SpatialFloor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  capturedAt            DateTime        @default(now())
  sourceType            String
  status                String          @default("CAPTURING")
  spatialScope          Json?
  localCoordinateFrame  Json?
  projectTransform      Json?
  qualityReport         Json?
  processingVersion     String?
  reconstructionVersion String?
  designReferenceProjectId String?
  designReferenceProject DesignProject? @relation("SnapshotDesignReference", fields: [designReferenceProjectId], references: [id], onDelete: SetNull)
  designReferenceVersion Int?
  publishedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  sourceRegistrations   CaptureRegistration[] @relation("RegistrationSource")
  targetRegistrations   CaptureRegistration[] @relation("RegistrationTarget")
  issues                ProjectIssue[]
  sourceObservations    AiObservation[] @relation("ObservationSource")
  targetObservations    AiObservation[] @relation("ObservationTarget")
  designRealityAlignments DesignRealityAlignment[]
  sourceAnalysisRuns ProgressAnalysisRun[] @relation("ProgressAnalysisSource")
  targetAnalysisRuns ProgressAnalysisRun[] @relation("ProgressAnalysisTarget")

  @@index([projectId, capturedAt])
  @@index([designReferenceProjectId])
  @@index([floorId])
}

model CaptureRegistration {
  id               String          @id @default(cuid())
  projectId        String
  project          ProgressProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceSnapshotId String
  sourceSnapshot   CaptureSnapshot @relation("RegistrationSource", fields: [sourceSnapshotId], references: [id], onDelete: Cascade)
  targetSnapshotId String
  targetSnapshot   CaptureSnapshot @relation("RegistrationTarget", fields: [targetSnapshotId], references: [id], onDelete: Cascade)
  transform        Json
  overlap          Float?
  confidence       Float
  method           String
  version          String
  status           String          @default("PROPOSED")
  verifiedById     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  analysisRuns     ProgressAnalysisRun[]

  @@unique([sourceSnapshotId, targetSnapshotId, version])
  @@index([projectId])
}

model DesignRealityAlignment {
  id                String          @id @default(cuid())
  projectId         String
  project           ProgressProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designProjectId   String
  designProject     DesignProject   @relation(fields: [designProjectId], references: [id], onDelete: Cascade)
  designVersion     Int
  realitySnapshotId String
  realitySnapshot   CaptureSnapshot @relation(fields: [realitySnapshotId], references: [id], onDelete: Cascade)
  spatialRoomId     String
  spatialRoom       SpatialRoom     @relation(fields: [spatialRoomId], references: [id], onDelete: Cascade)
  transform         Json
  confidence        Float
  overlap           Float?
  method             String
  version            String
  diagnostics        Json?
  status             String          @default("PROPOSED")
  verifiedById       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  evaluations        DesignRealityEvaluation[]

  @@index([projectId, updatedAt])
  @@index([designProjectId, designVersion])
  @@index([realitySnapshotId])
  @@index([spatialRoomId])
}

model DesignRealityEvaluation {
  id            String                 @id @default(cuid())
  projectId     String
  project       ProgressProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alignmentId   String
  alignment     DesignRealityAlignment @relation(fields: [alignmentId], references: [id], onDelete: Cascade)
  engineVersion String
  report        Json
  createdById   String
  createdAt     DateTime               @default(now())

  @@index([projectId, createdAt])
  @@index([alignmentId, createdAt])
}

model ProgressAnalysisRun {
  id               String              @id @default(cuid())
  projectId        String
  project          ProgressProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceSnapshotId String
  sourceSnapshot   CaptureSnapshot     @relation("ProgressAnalysisSource", fields: [sourceSnapshotId], references: [id], onDelete: Cascade)
  targetSnapshotId String
  targetSnapshot   CaptureSnapshot     @relation("ProgressAnalysisTarget", fields: [targetSnapshotId], references: [id], onDelete: Cascade)
  registrationId   String
  registration     CaptureRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  spatialRoomId    String?
  spatialRoom      SpatialRoom?        @relation(fields: [spatialRoomId], references: [id], onDelete: SetNull)
  status           String              @default("QUEUED")
  engineVersion    String
  modelVersion     String?
  policyVersion    String
  inputRegions     Json
  diagnostics      Json?
  jobId            String?             @unique
  job              ProcessingJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdById      String
  createdAt        DateTime            @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  observations     AiObservation[]

  @@index([projectId, createdAt])
  @@index([sourceSnapshotId, targetSnapshotId])
  @@index([registrationId])
  @@index([spatialRoomId])
}

model ProjectIssue {
  id                String           @id @default(cuid())
  projectId         String
  project           ProgressProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spatialRoomId     String?
  spatialRoom       SpatialRoom?     @relation(fields: [spatialRoomId], references: [id], onDelete: SetNull)
  captureSnapshotId String?
  captureSnapshot   CaptureSnapshot? @relation(fields: [captureSnapshotId], references: [id], onDelete: SetNull)
  spatialRef        Json?
  title             String
  description       String?
  status            String           @default("OPEN")
  severity          String           @default("INFO")
  assigneeId        String?
  dueAt             DateTime?
  resolvedAt        DateTime?
  closedById        String?
  verification      String           @default("UNVERIFIED")
  evidenceRefs      Json?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  events            IssueEvent[]

  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([spatialRoomId])
}

model IssueEvent {
  id          String       @id @default(cuid())
  issueId     String
  issue       ProjectIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId     String
  eventType   String
  fromStatus  String?
  toStatus    String?
  note        String?
  payload     Json?
  createdAt   DateTime     @default(now())

  @@index([issueId, createdAt])
  @@index([actorId])
}

model ProjectReport {
  id                String          @id @default(cuid())
  projectId         String
  project           ProgressProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportType        String          @default("MILESTONE")
  label             String?
  periodStart       DateTime?
  periodEnd         DateTime?
  schemaVersion     Int             @default(1)
  disclaimerVersion String
  content           Json
  generatedById     String
  createdAt         DateTime        @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, periodStart, periodEnd])
}

model AiObservation {
  id               String           @id @default(cuid())
  projectId        String
  project          ProgressProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceSnapshotId String?
  sourceSnapshot   CaptureSnapshot? @relation("ObservationSource", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  targetSnapshotId String?
  targetSnapshot   CaptureSnapshot? @relation("ObservationTarget", fields: [targetSnapshotId], references: [id], onDelete: SetNull)
  spatialRoomId    String?
  spatialRoom      SpatialRoom?     @relation(fields: [spatialRoomId], references: [id], onDelete: SetNull)
  observationType  String
  spatialRef       Json?
  structuredEvidence Json
  confidence       Float
  modelVersion     String?
  policyVersion    String?
  analysisRunId    String?
  analysisRun      ProgressAnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  status           String           @default("PROPOSED")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  decisions        ObservationDecision[]

  @@index([projectId, status])
  @@index([spatialRoomId])
  @@index([analysisRunId])
}

model ObservationDecision {
  id             String        @id @default(cuid())
  observationId  String
  observation    AiObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  actorId        String
  decision       String
  correctedValue Json?
  note           String?
  createdAt      DateTime      @default(now())

  @@index([observationId])
  @@index([actorId])
}

