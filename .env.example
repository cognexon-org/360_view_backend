# Copy this file to .env before starting.
COCKROACH_DATABASE=propertytour360
COCKROACH_USER=root
COCKROACH_PORT=26257
# CockroachDB connection URL for Docker Compose:
DATABASE_URL=postgresql://root@cockroach:26257/propertytour360?sslmode=disable
# CockroachDB connection URL for local dev outside Docker:
# DATABASE_URL=postgresql://root@localhost:26257/propertytour360?sslmode=disable
# Legacy PostgreSQL connection URL (used by data migration script):
OLD_DATABASE_URL=postgresql://propertytour:propertytour_dev_password@localhost:5432/propertytour360?schema=public

REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-another-long-random-secret
DEV_OTP_EXPOSE=true

MINIO_ROOT_USER=propertytour
MINIO_ROOT_PASSWORD=propertytour_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Hostname embedded in presigned upload URLs. Use your Mac/PC LAN IP for physical phones.
MINIO_PRESIGN_ENDPOINT=localhost
MINIO_PRESIGN_PORT=9000
MINIO_PRESIGN_USE_SSL=false
MINIO_BUCKET_PRIVATE=propertytour-private
MINIO_BUCKET_PUBLIC=propertytour-public
MINIO_PUBLIC_BASE_URL=http://localhost:9000/propertytour-public

VISION_SERVICE_URL=http://vision:8001
VISION_SHARED_SECRET=replace-with-a-service-secret
API_PORT=3000
LOG_LEVEL=info
